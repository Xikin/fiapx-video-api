{
  "openapi": "3.0.3",
  "info": {
    "title": "FIAP X — Video API",
    "version": "0.1.0",
    "description": "Envio de vídeos, acompanhamento do processamento e download dos frames."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "tags": ["Saúde"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "tags": ["Saúde"],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
