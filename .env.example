# Copie para .env. Os valores abaixo servem só para o ambiente local.

# Segredo do JWT, o mesmo do fiapx-auth-lambda. Gere um com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
JWT_ISSUER=fiapx-auth

# Para rodar a API fora do Docker (npm run dev) contra os serviços do docker compose:
DATABASE_URL=postgresql://fiapx:fiapx_local@localhost:5432/fiapx_videos
RABBITMQ_URL=amqp://fiapx:fiapx_local@localhost:5672
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=fiapx-videos
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_PORT=1025
VIDEO_TAMANHO_MAXIMO_MB=500
LOG_LEVEL=info
